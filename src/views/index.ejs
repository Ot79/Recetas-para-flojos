<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recetas para flojos</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="hero">
      <div class="hero__content">
        <p class="hero__eyebrow">Recetas para flojos</p>
        <h1>Comida rica, sin estrés y sin vueltas.</h1>
        <p>
          Publica tus recetas con ingredientes, fotos y pasos claros. Cada receta vive en
          su propia página para que la compartas con quien quieras.
        </p>
        <div class="hero__actions">
          <a class="button" href="/recipes/new">Subir receta</a>
        </div>
      </div>
    </header>

    <main class="container">
      <section>
        <div class="section__header">
          <h2>Últimas recetas</h2>
          <a class="link" href="/recipes/new">Crear nueva →</a>
        </div>
        <% if (recipes.length === 0) { %>
        <div class="empty">
          <p>No hay recetas todavía. ¡Sé la primera persona en subir una!</p>
        </div>
        <% } else { %>
        <div class="grid">
          <% recipes.forEach(recipe => { %>
          <article class="card">
            <div class="card__image">
              <% if (recipe.image_url) { %>
              <img src="<%= recipe.image_url %>" alt="Imagen de <%= recipe.title %>" />
              <% } else { %>
              <div class="card__placeholder">Sin foto</div>
              <% } %>
            </div>
            <div class="card__body">
              <h3><%= recipe.title %></h3>
              <p class="muted">Publicado: <%= new Date(recipe.created_at).toLocaleDateString('es-ES') %></p>
              <a class="button button--ghost" href="/recipes/<%= recipe.id %>">Ver receta</a>
            </div>
          </article>
          <% }) %>
        </div>
        <% } %>
      </section>
    </main>
  </body>
</html>
