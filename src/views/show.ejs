<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= recipe.title %> | Recetas para flojos</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="container">
      <a class="link" href="/">← Volver al inicio</a>
      <article class="detail">
        <div class="detail__header">
          <h1><%= recipe.title %></h1>
          <p class="muted">Publicado: <%= new Date(recipe.created_at).toLocaleDateString('es-ES') %></p>
        </div>
        <div class="detail__media">
          <% if (recipe.image_url) { %>
          <img src="<%= recipe.image_url %>" alt="Imagen de <%= recipe.title %>" />
          <% } else { %>
          <div class="detail__placeholder">Aún no hay imagen para esta receta.</div>
          <% } %>
        </div>
        <div class="detail__grid">
          <section>
            <h2>Ingredientes</h2>
            <pre><%= recipe.ingredients %></pre>
          </section>
          <section>
            <h2>Procedimiento</h2>
            <pre><%= recipe.procedure %></pre>
          </section>
        </div>
      </article>
    </main>
  </body>
</html>
